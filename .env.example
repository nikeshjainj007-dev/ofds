# Supabase Auth & Database Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# RazorPay Test Mode Credentials
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id

# Twilio Email Configuration (SendGrid Priority)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=auth@yourdomain.com

# Twilio Verify & Account Credentials (Alternative / Verify Email Channel)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
TWILIO_EMAIL_FROM=auth@yourdomain.com

# HMAC Secret Key for Stateless OTP Verification
OTP_SECRET_KEY=your-secure-hmac-secret-key

